<Window x:Class="BotView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chart="clr-namespace:BotView.Chart"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1200">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Label Content="BotView" FontSize="18" FontWeight="Bold" Width="100"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Separator Margin="2"/>
                    <Label Content="Биржа:" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ComboBox Name="cmbExchange"
                              Margin="2" Height="Auto"
                              ItemsSource="{Binding Exchanges}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedExchange, Mode=TwoWay}"/>

                    <Separator Margin="2"/>
                    <Label Content="Timeframe:" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <ComboBox Name="cmbTimeframe" Margin="2"
                              FontSize="14" FontWeight="Bold"
                              Height="Auto" MaxHeight="24"
                              ItemsSource="{Binding Timeframes}"
                              SelectedItem="{Binding SelectedTimeframe, Mode=TwoWay}"/>
                </StackPanel>

                <Grid Width="180" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="txtSymbolSearch"
                             Focusable="True"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="180"
                             FontSize="14"
                             ToolTip="Search coins"
                             GotFocus="TxtSymbolSearch_GotFocus"
                             LostFocus="TxtSymbolSearch_LostFocus"/>
                    <TextBlock Text="Search coins"
                               IsHitTestVisible="False"
                               Foreground="Gray"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSymbolSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Popup IsOpen="{Binding IsSearchDropdownOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=txtSymbolSearch}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="White"
                                BorderBrush="#FFAAAAAA"
                                BorderThickness="1"
                                MaxHeight="240"
                                MinWidth="{Binding ActualWidth, ElementName=txtSymbolSearch}">
                            <ListBox ItemsSource="{Binding SearchResults}"
                                     MaxHeight="240"
                                     BorderThickness="0"
                                     PreviewMouseLeftButtonDown="SearchResults_PreviewMouseLeftButtonDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>

            <!-- Status Bar at Bottom -->
            <StatusBar DockPanel.Dock="Bottom" Height="30" Name="statusBar">
                <StatusBarItem>
                    <TextBlock Name="fpsCounter" Text="{Binding RenderTimeText}" Margin="5,0"/>
                </StatusBarItem>
            </StatusBar>

            <!-- Main Content Area with Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <!-- Left Menu Panel -->
                <StackPanel Grid.Column="0" Background="LightGray" Margin="5">
                    <Label Content="Управление графиком" FontWeight="Bold" HorizontalAlignment="Center"/>

                    <Button Name="btnSnapLastToRight" Content="Прижать вправо" Margin="2"
                            Command="{Binding SnapLastToRightCommand}" ToolTip="Прижать вправо"/>

                    <Separator Margin="2"/>
                    <TextBlock Text="Инструменты" Margin="2"/>
                    <Button Name="btnHorizontalLine" Margin="2"
                            Command="{Binding StartHorizontalLineCommand}" ToolTip="Горизонтальная линия">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M5.13,31c31.04-0.5,53.74,0,53.74,0"
                                          Stroke="Black" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse Canvas.Left="28.5" Canvas.Top="26.5" Width="8" Height="8"
                                             Stroke="Black" StrokeThickness="2" Fill="White"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Горизонтальная линия" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Name="btnHorizontalRay" Margin="2"
                            Command="{Binding StartHorizontalRayCommand}" ToolTip="Горизонтальный луч">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M13.5,32 L58.87,32"
                                          Stroke="Black" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse Canvas.Left="9.5" Canvas.Top="28" Width="8" Height="8"
                                             Stroke="Black" StrokeThickness="2" Fill="White"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Горизонтальный луч" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Name="btnTrendLine" Margin="2"
                            Command="{Binding StartTrendLineCommand}" ToolTip="Трендовая линия">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M14,50c21.59-22.3,38-38,38-38"
                                        Stroke="Black" StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse Canvas.Left="9.5" Canvas.Top="45.5" Width="8" Height="8"
                                            Stroke="Black" StrokeThickness="2" Fill="White"/>
                                    <Ellipse Canvas.Left="47.5" Canvas.Top="8.5" Width="8" Height="8"
                                        Stroke="Black" StrokeThickness="2" Fill="White"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Трендовая линия" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Name="btnTrendChannel" Margin="2"
                            Command="{Binding StartTrendChannelCommand}" ToolTip="Трендовый канал">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M14,50 L52,22"
                                          Stroke="Black" StrokeThickness="2" Fill="Transparent" HorizontalAlignment="Left" Canvas.Top="4" VerticalAlignment="Center" Canvas.Left="2"/>
                                    <Path Data="M14,36 L52,8"
                                          Stroke="Black" StrokeThickness="2" Fill="Transparent" HorizontalAlignment="Left" Canvas.Top="1" VerticalAlignment="Center" Canvas.Left="-1"/>
                                    <Ellipse Canvas.Left="8" Canvas.Top="33" Width="8" Height="8"
                                             Stroke="Black" StrokeThickness="2" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <Ellipse Canvas.Left="33" Canvas.Top="34" Width="8" Height="8"
                                             Stroke="Black" StrokeThickness="2" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Ellipse Canvas.Left="45" Canvas.Top="6" Width="8" Height="8"
                                             Stroke="Black" StrokeThickness="2" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Трендовый канал" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Name="btnRectangle" Margin="2"
                            Command="{Binding StartRectangleCommand}" ToolTip="Прямоугольник">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="64" Height="64">
                                    <Rectangle Canvas.Left="10" Canvas.Top="16" Width="44" Height="32"
                                               Stroke="Black" StrokeThickness="2" Fill="White"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Прямоугольник" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="2,8,2,8"/>
                    <Button Name="btnShowMetrics" Content="Показать метрики" Margin="2"
                            Command="{Binding ShowMetricsCommand}" ToolTip="Показать метрику (debug)"/>
                    <Button Name="btnExportMetrics" Content="Экспорт метрик" Margin="2"
                            Command="{Binding ExportMetricsCommand}" ToolTip="Экспортировать метрику"/>

                    <Separator Margin="2"/>
                    <TextBlock Text="Инструкции:" FontSize="10" FontWeight="Bold" Margin="2"/>
                    <TextBlock Text="• Перетаскивание мышью для панорамирования" FontSize="9" TextWrapping="Wrap" Margin="2"/>
                    <TextBlock Text="• Колесо мыши для масштабирования" FontSize="9" TextWrapping="Wrap" Margin="2"/>
                </StackPanel>

                <!-- Chart View - Takes all remaining space -->
                <chart:ChartView Grid.Column="1" x:Name="chartView" />

                <!-- Right Panel -->
                <StackPanel Grid.Column="2" Background="LightGray" Margin="5">
                    <Label Content="Торговые пары" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <ListBox Name="lstTradingPairs" Margin="2"
                             ItemsSource="{Binding TradingPairs}"
                             DisplayMemberPath="Symbol"
                             SelectedValuePath="Symbol"
                             SelectedValue="{Binding SelectedSymbol, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- Loading overlay -->
        <Border Background="#99000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                d:IsHidden="True"
                Panel.ZIndex="100"
                IsHitTestVisible="True">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="6" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding BusyMessage}"
                           Foreground="White"
                           FontSize="16"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
