<Window x:Class="BotView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chart="clr-namespace:BotView.Chart"
        mc:Ignorable="d"
        Title="BotView — Trading workspace" Height="820" Width="1320"
        MinHeight="620" MinWidth="980"
        Background="#0B1120" Foreground="#E5E7EB" FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#182235"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#263449"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#22304A"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="FavoriteButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentPairFavorite}" Value="True">
                    <Setter Property="Foreground" Value="#FBBF24"/>
                    <Setter Property="BorderBrush" Value="#B7791F"/>
                    <Setter Property="Background" Value="#332A16"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style x:Key="MarketTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="MoversListTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ТОП-10 · ЗА ПОСЛЕДНИЕ 24 ЧАСА"
                           Style="{StaticResource SectionTitleStyle}" Margin="2,12,0,10"/>
                <TextBlock Grid.Row="1" Text="Нет монет в этой категории"
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox Grid.Row="1" ItemsSource="{Binding}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    PreviewMouseRightButtonDown="Pair_PreviewMouseRightButtonDown"
                                    HorizontalContentAlignment="Stretch" Padding="8,10" Margin="0,0,0,5"
                                    ToolTip="Открыть график"
                                    Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Symbol}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ChangeText}" Foreground="{Binding ChangeColor}" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,92,0">
                    <TextBlock Text="BOTVIEW" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="MARKET TERMINAL" FontSize="9" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="ИСТОЧНИК" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,3"/>
                    <ComboBox Name="cmbExchange" Width="180" ItemsSource="{Binding Exchanges}"
                              
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedExchange, Mode=TwoWay}" Foreground="#FF1754CE">
                        <ComboBox.Background>
                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.DesktopColorKey}}"/>
                        </ComboBox.Background>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,14,0" Visibility="{Binding IsChartMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="ТАЙМФРЕЙМ" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,3"/>
                    <ComboBox Name="cmbTimeframe" Width="105" FontWeight="SemiBold"
                              ItemsSource="{Binding Timeframes}"
                              SelectedItem="{Binding SelectedTimeframe, Mode=TwoWay}" Foreground="#FF2F4B84">
                        <ComboBox.Background>
                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.DesktopColorKey}}"/>
                        </ComboBox.Background>
                    </ComboBox>
                </StackPanel>
                <Grid Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <TextBox x:Name="txtSymbolSearch"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Width="400"
                            FontSize="14" ToolTip="{Binding SearchPlaceholder}"
                            GotFocus="TxtSymbolSearch_GotFocus" LostFocus="TxtSymbolSearch_LostFocus"/>
                    <TextBlock Text="{Binding SearchPlaceholder}" IsHitTestVisible="False"
                            Foreground="{StaticResource TextMutedBrush}" Padding="12,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSymbolSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Popup IsOpen="{Binding IsSearchDropdownOpen, Mode=TwoWay}"
                        PlacementTarget="{Binding ElementName=txtSymbolSearch}" Placement="Bottom"
                        StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="#3B82F6"
                            BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" MaxHeight="280"
                            MinWidth="{Binding ActualWidth, ElementName=txtSymbolSearch}">
                            <ListBox x:Name="lstSearchResults" ItemsSource="{Binding SearchResults}" Background="Transparent"
                                Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                PreviewMouseLeftButtonDown="SearchResults_PreviewMouseLeftButtonDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="Pair_PreviewMouseRightButtonDown"/>
                                        <Setter Property="Padding" Value="10,7"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>

                </Grid>
                <Button Grid.Column="4" Style="{StaticResource FavoriteButtonStyle}"
                        Visibility="{Binding IsChartMode, Converter={StaticResource BoolToVis}}"
                        Content="{Binding FavoriteActionText}" Command="{Binding ToggleFavoriteCommand}"
                        ToolTip="{Binding FavoritesFilePath}" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" DataContext="{Binding FuturesQuote}"
                Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="S&amp;P 500 · ФЬЮЧЕРС ES=F"
                           FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontSize="17" FontWeight="Bold"
                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding ChangeText}" Foreground="{Binding ChangeColor}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding StatusText}" ToolTip="{Binding StatusText}"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="12" Visibility="{Binding IsChartMode, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="ГРАФИК" Style="{StaticResource SectionTitleStyle}"/>
                    <Button Name="btnSnapLastToRight" Content="Прижать вправо"
                            Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SnapLastToRightCommand}"/>
                    <Button Content="Сбросить масштаб Y" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ResetVerticalScaleCommand}"/>
                    <CheckBox Name="chkCandleOutline" Content="Обводка свечей"
                              IsChecked="{Binding ShowCandleOutlines, ElementName=chartView, Mode=TwoWay}"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,0,10"
                              ToolTip="Включить или отключить контур тел свечей"/>
                    <TextBlock Text="ИНДИКАТОРЫ" Style="{StaticResource SectionTitleStyle}" Margin="2,10,0,6"/>
                    <Button Name="btnAddRsi" Content="Добавить RSI" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding Controller.ShowRsiCommand, ElementName=chartView}"
                            ToolTip="Открыть панель индикаторов с RSI"/>
                    <TextBlock Text="СРАВНЕНИЕ" Style="{StaticResource SectionTitleStyle}" Margin="2,8,0,6"/>
                    <Grid>
                        <TextBox x:Name="txtComparisonSearch" Width="148" HorizontalAlignment="Left"
                                 Text="{Binding ComparisonSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Найти пару для сравнения"
                                 GotFocus="TxtComparisonSearch_GotFocus"
                                 LostFocus="TxtComparisonSearch_LostFocus"/>
                        <TextBlock Text="Найти пару" Foreground="{StaticResource TextMutedBrush}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtComparisonSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Popup IsOpen="{Binding IsComparisonDropdownOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=txtComparisonSearch}" Placement="Bottom"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="#8B5CF6"
                                    BorderThickness="1" CornerRadius="6" Margin="0,4,0,0"
                                    Width="220" MaxHeight="250">
                                <ListBox ItemsSource="{Binding ComparisonSearchResults}" Background="Transparent"
                                         Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                         PreviewMouseLeftButtonDown="ComparisonResults_PreviewMouseLeftButtonDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,7"/>
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Pair_PreviewMouseRightButtonDown"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock Text="{Binding ComparisonSymbol, StringFormat=Линия: {0}}"
                               Foreground="#A78BFA" Margin="2,7,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Убрать сравнение" Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding RemoveComparisonCommand}"
                            Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding ComparisonStatusText}" Foreground="#FBBF24"
                               TextWrapping="Wrap" FontSize="10" Margin="2,0,0,4"/>
                    <TextBlock Text="ИНСТРУМЕНТЫ" Style="{StaticResource SectionTitleStyle}" Margin="2,10,0,6"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Name="btnHorizontalLine" Style="{StaticResource IconButtonStyle}"
                                Command="{Binding StartHorizontalLineCommand}" ToolTip="Горизонтальная линия">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M5.13,31 L58.87,31" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="28.5" Canvas.Top="26.5" Width="8" Height="8" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Fill="{StaticResource SurfaceRaisedBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Name="btnHorizontalRay" Style="{StaticResource IconButtonStyle}"
                                Command="{Binding StartHorizontalRayCommand}" ToolTip="Горизонтальный луч">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M13.5,32 L58.87,32" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="9.5" Canvas.Top="28" Width="8" Height="8" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Fill="{StaticResource SurfaceRaisedBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Name="btnTrendLine" Style="{StaticResource IconButtonStyle}"
                                Command="{Binding StartTrendLineCommand}" ToolTip="Трендовая линия">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M14,50 L52,12" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="9.5" Canvas.Top="45.5" Width="8" Height="8" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Fill="{StaticResource SurfaceRaisedBrush}"/>
                                    <Ellipse Canvas.Left="47.5" Canvas.Top="8.5" Width="8" Height="8" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Fill="{StaticResource SurfaceRaisedBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Name="btnTrendChannel" Style="{StaticResource IconButtonStyle}"
                                Command="{Binding StartTrendChannelCommand}" ToolTip="Трендовый канал">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M12,52 L54,22 M10,39 L52,9" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="8" Canvas.Top="34" Width="8" Height="8" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Fill="{StaticResource SurfaceRaisedBrush}"/>
                                    <Ellipse Canvas.Left="47" Canvas.Top="5" Width="8" Height="8" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Fill="{StaticResource SurfaceRaisedBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Name="btnRectangle" Style="{StaticResource IconButtonStyle}"
                                Command="{Binding StartRectangleCommand}" ToolTip="Прямоугольник">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="64" Height="64">
                                    <Rectangle Canvas.Left="10" Canvas.Top="16" Width="44" Height="32" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Name="btnMeasure" Style="{StaticResource IconButtonStyle}"
                                Command="{Binding StartMeasureCommand}" ToolTip="Линейка">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M8,42 L42,8 L56,22 L22,56 Z M17,33 L24,40 M25,25 L32,32 M33,17 L40,24"
                                          Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </WrapPanel>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14"/>
                    <TextBlock Text="ДИАГНОСТИКА" Style="{StaticResource SectionTitleStyle}"/>
                    <Button Name="btnShowMetrics" Content="Показать метрики"
                            Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ShowMetricsCommand}"/>
                    <Button Name="btnExportMetrics" Content="Экспорт метрик"
                            Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ExportMetricsCommand}"/>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="AliceBlue" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <chart:ChartView x:Name="chartView"/>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TabControl Grid.RowSpan="3" Background="Transparent" BorderThickness="0"
                                ItemContainerStyle="{StaticResource MarketTabStyle}" Padding="0">
                        <TabItem Header="Избранное">
                            <StackPanel Orientation="Vertical">
                                
                                <TextBlock Grid.Row="1" Text="Список для выбранной биржи"
Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="2,0,0,10"/>
                                <Grid Grid.Row="2">
                                    <TextBlock Text="Добавьте текущую пару кнопкой ★"
    Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"
    TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="150">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=lstTradingPairs}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ListBox Name="lstTradingPairs" ItemsSource="{Binding TradingPairs}"
  SelectedValuePath="Symbol" SelectedValue="{Binding SelectedSymbol, Mode=TwoWay}"
  Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="Pair_PreviewMouseRightButtonDown"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,5"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#2563EB"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="7,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="★" Foreground="#FBBF24" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Symbol}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="×" Width="25" Height="25" Padding="0" Margin="5,0,0,0"
                 Background="Transparent" Foreground="#475569"
                 BorderThickness="0" Cursor="Hand" ToolTip="Удалить из избранного"
                 Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                 CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </StackPanel>
                            
                        </TabItem>
                        <TabItem Header="Упавшие">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding MarketMovers.StatusText}" ToolTip="{Binding MarketMovers.StatusText}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <Button Content="Обновить" Style="{StaticResource ToolbarButtonStyle}" Margin="0,8,0,0"
                                            Command="{Binding MarketMovers.RefreshCommand}"/>
                                </StackPanel>
                                <ContentControl Content="{Binding MarketMovers.Losers}" ContentTemplate="{StaticResource MoversListTemplate}"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Выросшие">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding MarketMovers.StatusText}" ToolTip="{Binding MarketMovers.StatusText}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <Button Content="Обновить" Style="{StaticResource ToolbarButtonStyle}" Margin="0,8,0,0"
                                            Command="{Binding MarketMovers.RefreshCommand}"/>
                                </StackPanel>
                                <ContentControl Content="{Binding MarketMovers.Gainers}" ContentTemplate="{StaticResource MoversListTemplate}"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                    
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="12" Style="{StaticResource CardStyle}"
                Visibility="{Binding IsInstrumentCatalogMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock Text="ИНСТРУМЕНТЫ МОСБИРЖИ" Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <ComboBox Width="155" ItemsSource="{Binding CatalogCategories}"
                              SelectedItem="{Binding SelectedCatalogCategory}"/>
                    <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCatalogCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" Margin="10,0,0,0"/>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                                 Visibility="{Binding IsCatalogLoading, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Загрузка каталога QUIK…" Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding IsCatalogLoading, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding CatalogErrorText}" Foreground="#FBBF24" TextWrapping="Wrap"/>
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding CatalogRows}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True" HeadersVisibility="Column"
                          Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                          RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="{StaticResource SurfaceRaisedBrush}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          BorderBrush="{StaticResource BorderBrush}" RowHeight="30">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                        <DataGridTextColumn Header="Тикер" Binding="{Binding Ticker}" Width="150"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="200"/>
                        <DataGridTextColumn Header="Класс" Binding="{Binding ClassCode}" Width="100"/>
                        <DataGridTextColumn Header="Лот" Binding="{Binding LotSize, TargetNullValue=—}" Width="90"/>
                        <DataGridTextColumn Header="Шаг цены" Binding="{Binding PriceStep, TargetNullValue=—}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock Text="{Binding CatalogCountText}" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Каталог терминала · Графики и торговые операции пока недоступны"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <TextBlock Text="●  LIVE" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"
                           Visibility="{Binding IsChartMode, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="КАТАЛОГ ИНСТРУМЕНТОВ" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           Visibility="{Binding IsInstrumentCatalogMode, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding RenderTimeText}" Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding IsChartMode, Converter={StaticResource BoolToVis}}"
                           FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <Border Grid.RowSpan="4" Background="#B30B1120"
                Visibility="{Binding IsBlockingBusy, Converter={StaticResource BoolToVis}}"
                d:IsHidden="True" Panel.ZIndex="100" IsHitTestVisible="True">
            <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="28,22"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="240" Height="5" Margin="0,0,0,14"/>
                    <TextBlock Text="{Binding BusyMessage}" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
