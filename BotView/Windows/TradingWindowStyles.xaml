<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Button">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Background" Value="#263449"/>
        <Setter Property="Foreground" Value="#F3F4F6"/>
        <Setter Property="BorderBrush" Value="#475569"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Background" Value="#182235"/>
        <Setter Property="Foreground" Value="#F3F4F6"/>
        <Setter Property="BorderBrush" Value="#475569"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#E5E7EB"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#172033"/>
        <Setter Property="Padding" Value="5,3"/>
    </Style>
    <Style x:Key="OptionalText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#182235"/>
        <Setter Property="Foreground" Value="#E5E7EB"/>
        <Setter Property="RowBackground" Value="#182235"/>
        <Setter Property="AlternatingRowBackground" Value="#202D40"/>
        <Setter Property="BorderBrush" Value="#334155"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ColumnWidth" Value="SizeToHeader"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#263449"/>
        <Setter Property="Foreground" Value="#E5E7EB"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>
