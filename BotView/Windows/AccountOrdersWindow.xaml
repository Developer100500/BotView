<Window x:Class="BotView.Windows.AccountOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1050" Height="580" MinWidth="720" MinHeight="360"
        Background="#0B1120" Foreground="#E5E7EB" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="TradingWindowStyles.xaml"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding ContextText}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding ContextText}" Margin="0,0,0,6"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Reconnect" Command="{Binding ReconnectCommand}" Margin="8,0,0,0"/>
            <StackPanel>
                <TextBlock Text="{Binding AccountIdentity}" Style="{StaticResource OptionalText}"/>
                <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource OptionalText}"/>
            </StackPanel>
        </DockPanel>
        <TabControl Grid.Row="2" Background="#182235" BorderBrush="#334155" Padding="4">
            <TabItem Header="Orders">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="OrdersTable" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Reference.Category}"/>
                            <DataGridTextColumn Header="Side" Binding="{Binding Side}"/>
                            <DataGridTextColumn Header="Position" Binding="{Binding PositionSide}"/>
                            <DataGridTextColumn Header="Reduce-only" Binding="{Binding ReduceOnly}"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price}"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}"/>
                            <DataGridTextColumn Header="Filled" Binding="{Binding FilledQuantity}"/>
                            <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingQuantity}"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding StatusReason}"/>
                            <DataGridTextColumn Header="Order ID" Binding="{Binding Reference.ExchangeOrderId}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <Button Content="Cancel selected" Command="{Binding CancelSelectedCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel all for pair" Command="{Binding CancelAllCommand}"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Executions">
                <DataGrid ItemsSource="{Binding Executions}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding ExecutedAt, StringFormat=HH:mm:ss}"/>
                        <DataGridTextColumn Header="Side" Binding="{Binding Side}"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price}"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}"/>
                        <DataGridTextColumn Header="Fee" Binding="{Binding Fee.Amount}"/>
                        <DataGridTextColumn Header="Currency" Binding="{Binding Fee.Currency}"/>
                        <DataGridTextColumn Header="Order ID" Binding="{Binding Order.ExchangeOrderId}"/>
                        <DataGridTextColumn Header="Execution ID" Binding="{Binding ExecutionId}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" Text="{Binding OperationStatus}" Style="{StaticResource OptionalText}"
                   Foreground="#FBBF24" Margin="0,6,0,0" MaxHeight="65"/>
    </Grid>
</Window>
