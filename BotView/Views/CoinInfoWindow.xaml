<Window x:Class="BotView.Views.CoinInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="680" Height="620" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#0B1120" Foreground="#F3F4F6"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{Binding Pair}" Foreground="#22C55E" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Name}" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding CategoriesText}" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
            <TextBlock Text="Выберите проект с нужным тикером" Foreground="#94A3B8" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName" MinHeight="32" Foreground="#111827"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusText}" Foreground="#94A3B8" TextWrapping="Wrap"/>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        <Border Grid.Row="3" Background="#111827" BorderBrush="#263449" BorderThickness="1" CornerRadius="8" Padding="14"
                Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding LanguageText}" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,10"/>
                <TextBox x:Name="DescriptionText" Grid.Row="1" Text="{Binding Description, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" Foreground="#E5E7EB" BorderThickness="0" FontSize="14" Padding="0"
                         VerticalContentAlignment="Top"/>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}">
                    <Hyperlink NavigateUri="{Binding SourceUrl}" RequestNavigate="OpenLink" Foreground="#60A5FA">Источник: CoinGecko</Hyperlink>
                </TextBlock>
                <TextBlock Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                    <Hyperlink NavigateUri="{Binding WebsiteUrl}" RequestNavigate="OpenLink" Foreground="#60A5FA">Сайт проекта</Hyperlink>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="Повторить" Command="{Binding RetryCommand}" Padding="14,8" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>
